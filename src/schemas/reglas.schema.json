{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reglas de coherencia",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "nivel_minimo",
      "severidad",
      "bloquea_copiar",
      "condicion",
      "mensaje",
      "referencia_normativa",
      "detalle_normativo"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "nivel_minimo": {
        "enum": [
          "basico",
          "avanzado",
          "experto"
        ]
      },
      "revisar": {
        "type": "boolean"
      },
      "severidad": {
        "enum": [
          "critico",
          "aviso",
          "info"
        ]
      },
      "bloquea_copiar": {
        "type": "boolean"
      },
      "condicion": {
        "$ref": "#/$defs/condicion"
      },
      "mensaje": {
        "type": "string",
        "minLength": 1
      },
      "mensaje_sin_nivel": {
        "type": "string",
        "minLength": 1
      },
      "accion": {
        "type": "object",
        "required": [
          "tipo",
          "valor",
          "etiqueta"
        ],
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "enum": [
              "cambiar_tipo_material",
              "activar_variable",
              "activar_salida",
              "ir_a_campo"
            ]
          },
          "valor": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "etiqueta": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "referencia_normativa": {
        "type": "string"
      },
      "detalle_normativo": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "condicion": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "todas"
          ],
          "additionalProperties": false,
          "properties": {
            "todas": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condicion"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "alguna"
          ],
          "additionalProperties": false,
          "properties": {
            "alguna": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condicion"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "no"
          ],
          "additionalProperties": false,
          "properties": {
            "no": {
              "$ref": "#/$defs/condicion"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "campo"
          ],
          "additionalProperties": false,
          "properties": {
            "campo": {
              "enum": [
                "etapa",
                "ciclo",
                "curso",
                "tipo_material",
                "es_evaluacion",
                "adaptacion",
                "nivel",
                "perfiles",
                "n_perfiles",
                "variables_activas",
                "n_medidas",
                "nivel_referencia",
                "tipo_archivo",
                "mantener_criterios",
                "datos_personales",
                "salidas"
              ]
            },
            "igual": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            },
            "distinto": {
              "type": [
                "string",
                "boolean",
                "number"
              ]
            },
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "incluye": {
              "type": "string"
            },
            "incluye_alguno": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vacio": {
              "type": "boolean"
            },
            "mayor_que": {
              "type": "number"
            },
            "minimo": {
              "type": "number"
            }
          }
        }
      ]
    }
  }
}
