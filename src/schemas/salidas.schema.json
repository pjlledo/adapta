{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entregables y formatos de entrega",
  "type": "object",
  "required": [
    "entregables",
    "formatos",
    "alternativa_sin_archivos",
    "maquetacion_fija",
    "referencia_documento"
  ],
  "additionalProperties": false,
  "properties": {
    "entregables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nivel_minimo",
          "orden",
          "etiqueta",
          "ayuda",
          "obligatorio",
          "valor_defecto",
          "fragmento_prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "nivel_minimo": {
            "enum": [
              "basico",
              "avanzado",
              "experto"
            ]
          },
          "revisar": {
            "type": "boolean"
          },
          "orden": {
            "type": "integer",
            "minimum": 1
          },
          "etiqueta": {
            "type": "string",
            "minLength": 1
          },
          "ayuda": {
            "type": "string",
            "minLength": 1
          },
          "obligatorio": {
            "type": "boolean"
          },
          "valor_defecto": {
            "type": "boolean"
          },
          "sustituye_a": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "fragmento_prompt": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "formatos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "nivel_minimo",
          "por_defecto",
          "etiqueta",
          "fragmento_prompt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "nivel_minimo": {
            "enum": [
              "basico",
              "avanzado",
              "experto"
            ]
          },
          "revisar": {
            "type": "boolean"
          },
          "por_defecto": {
            "type": "boolean"
          },
          "etiqueta": {
            "type": "string",
            "minLength": 1
          },
          "fragmento_prompt": {
            "type": "string",
            "minLength": 1
          },
          "omite_alternativa": {
            "type": "boolean"
          }
        }
      }
    },
    "alternativa_sin_archivos": {
      "type": "string",
      "minLength": 1
    },
    "maquetacion_fija": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "referencia_documento": {
      "type": "object",
      "required": [
        "adjunto",
        "pegado"
      ],
      "additionalProperties": false,
      "properties": {
        "adjunto": {
          "type": "string",
          "minLength": 1
        },
        "pegado": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
