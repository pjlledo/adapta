{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tipos de adaptación (destinatarios)",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "nivel_minimo",
      "nivel_respuesta",
      "por_defecto",
      "nombre",
      "descripcion",
      "titulo_perfiles",
      "descripcion_prompt",
      "variables_preseleccionadas",
      "referencia_normativa"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "nivel_minimo": {
        "enum": [
          "basico",
          "avanzado",
          "experto"
        ]
      },
      "revisar": {
        "type": "boolean"
      },
      "nivel_respuesta": {
        "enum": [
          "II",
          "III",
          "IV"
        ]
      },
      "por_defecto": {
        "type": "boolean"
      },
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "descripcion": {
        "type": "string",
        "minLength": 1
      },
      "titulo_perfiles": {
        "type": "string",
        "minLength": 1
      },
      "descripcion_prompt": {
        "type": "string",
        "minLength": 1
      },
      "variables_preseleccionadas": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            {
              "type": "object",
              "required": [
                "id",
                "valor"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "valor": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "array"
                  ]
                }
              }
            }
          ]
        }
      },
      "requiere": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "aviso": {
        "type": "string",
        "minLength": 1
      },
      "referencia_normativa": {
        "type": "string"
      }
    }
  }
}
