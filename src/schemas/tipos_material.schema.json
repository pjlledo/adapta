{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tipos de material",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "id",
      "nivel_minimo",
      "nombre",
      "nombre_prompt",
      "descripcion",
      "es_evaluacion",
      "variables_sugeridas",
      "avisos"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      },
      "nivel_minimo": {
        "enum": [
          "basico",
          "avanzado",
          "experto"
        ]
      },
      "revisar": {
        "type": "boolean"
      },
      "nombre": {
        "type": "string",
        "minLength": 1
      },
      "nombre_prompt": {
        "type": "string",
        "minLength": 1
      },
      "descripcion": {
        "type": "string",
        "minLength": 1
      },
      "es_evaluacion": {
        "type": "boolean"
      },
      "variables_sugeridas": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "avisos": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
